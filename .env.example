# CreatorHub v0.1 — every variable either app reads. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Real credentials never enter the repository; production values are set in the
# Render and Vercel dashboards (T071), not here.

# ---------------------------------------------------------------------------
# Postgres (docker-compose service `db`)
# ---------------------------------------------------------------------------
POSTGRES_USER=creatorhub
POSTGRES_PASSWORD=creatorhub
POSTGRES_DB=creatorhub
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend — FastAPI (backend/app/config.py, T008)
# ---------------------------------------------------------------------------

# SQLAlchemy URL. Inside compose the host is `db`; from the host shell it is localhost, which is what
# running Alembic or pytest outside the container needs:
#   postgresql+psycopg://creatorhub:creatorhub@localhost:5432/creatorhub
DATABASE_URL=postgresql+psycopg://creatorhub:creatorhub@localhost:5432/creatorhub

# Dedicated test database — workflow.md stage 5. Created by scripts/init-test-db.sql on first
# `docker compose up`. pytest must never point at DATABASE_URL; the harness (T017) truncates.
TEST_DATABASE_URL=postgresql+psycopg://creatorhub:creatorhub@localhost:5432/creatorhub_test

# Signs the session JWT. No default anywhere in the code — an app that boots with a guessable secret
# is worse than one that refuses to boot. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# FR-002a: a session lasts ~30 days and slides on use (research.md R-002). Changing this changes how
# long a leaked token stays valid — there is no denylist at v0.1.
TOKEN_TTL_DAYS=30

# CORS allowlist. Defence in depth only: research.md R-008 makes the proxy allowlist the real
# boundary, since no browser ever contacts the backend origin directly.
FRONTEND_ORIGIN=http://localhost:3000

BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# The single account (backend/app/scripts/seed_user.py, T015)
# ---------------------------------------------------------------------------
# There is no registration endpoint — tech-defaults.md, constitution VII. This script is the only
# thing that creates a creator.
SEED_CREATOR_EMAIL=
SEED_CREATOR_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend — Next.js (T022 proxy, T025 login)
# ---------------------------------------------------------------------------

# Where the proxy forwards to, server-side. Not NEXT_PUBLIC_ on purpose: research.md R-001 requires
# the backend origin to stay invisible to the browser. In production this is the Render URL.
API_BASE_URL=http://localhost:8000

# The httpOnly session cookie holding the JWT (research.md R-001).
SESSION_COOKIE_NAME=ch_session

# Must be true in production. False locally because a Secure cookie is not stored over plain http.
SESSION_COOKIE_SECURE=false

FRONTEND_PORT=3000

# Object storage (Cloudflare R2) — added at 003-travel-map T001
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Travel Intelligence (the AI module) — backend/app/ai/
# ---------------------------------------------------------------------------
# Hugging Face access token. Create at https://huggingface.co/settings/tokens — a `read` token is
# enough for inference. NEVER commit the real value: this file is the documentation, `.env` holds
# the secret and is gitignored.
HF_TOKEN=

# Model id sent to the Hugging Face router. It must be served by at least one inference provider,
# otherwise the router answers 404 and the console says so. Replace this with your own fine-tuned
# adapter once `ai/` produces one — that swap is the whole of the integration step.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
